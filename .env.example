# Local development only. Generate random values with:
# bash scripts/dev/generate-compose-env.sh
# This template intentionally contains no usable signing keys.
HEIMDALL_SECURITY_VEHICLE_TOKEN_SECRET=
HEIMDALL_SECURITY_VEHICLE_TOKEN_TTL=5m
HEIMDALL_SECURITY_RELEASE_SIGNING_PRIVATE_KEY=
HEIMDALL_SECURITY_RELEASE_SIGNING_KEY_ID=local-compose-ed25519-v1
# Simulator receives only this public key and its matching identifier.
HEIMDALL_OTA_SIGNING_PUBLIC_KEY=
HEIMDALL_OTA_SIGNING_KEY_ID=local-compose-ed25519-v1
